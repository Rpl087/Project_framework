##############################################################################
#  LabManager — Template .env untuk PRODUCTION (cPanel / Shared Hosting)
#  INSTRUKSI:
#   1. Salin file ini ke server, rename jadi ".env"
#   2. Isi semua nilai yang bertanda <<< GANTI >>>
#   3. Jalankan: php artisan key:generate
##############################################################################

APP_NAME=LabManager
APP_ENV=production
APP_KEY=                          # <<< Akan diisi otomatis oleh: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://namadomain.com    # <<< GANTI dengan domain hosting Anda (dengan https://)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Di production cukup level error, bukan debug

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                 # Biasanya 127.0.0.1 di shared hosting
DB_PORT=3306
DB_DATABASE=namacpanel_labmanager # <<< GANTI: username_cPanel + nama DB yang dibuat
DB_USERNAME=namacpanel_dbuser     # <<< GANTI: username DB dari cPanel
DB_PASSWORD=passwordDB            # <<< GANTI: password DB dari cPanel

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null               # Isi domain jika perlu: .namadomain.com

# ── Cache & Queue ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync             # Pakai sync di shared hosting (tidak ada queue worker)
CACHE_STORE=database
CACHE_PREFIX=

# ── Mail — Gmail App Password ─────────────────────────────────────────────────
# Cara mendapatkan Gmail App Password:
# 1. Aktifkan 2-Factor Authentication di akun Gmail Anda
# 2. Buka: myaccount.google.com/apppasswords
# 3. Pilih "Mail" + "Other device", beri nama "LabManager"
# 4. Salin 16-karakter App Password yang diberikan

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emailanda@gmail.com # <<< GANTI: email Gmail Anda
MAIL_PASSWORD=xxxx xxxx xxxx xxxx # <<< GANTI: 16-karakter App Password Gmail
MAIL_FROM_ADDRESS=emailanda@gmail.com # <<< GANTI: sama dengan MAIL_USERNAME
MAIL_FROM_NAME="${APP_NAME}"

# ── Proxy / HTTPS (penting untuk shared hosting dengan SSL) ──────────────────
TRUSTED_PROXIES=*
TRUSTED_HOSTS=namadomain.com      # <<< GANTI dengan domain Anda (tanpa https://)

# ── AWS (tidak digunakan, biarkan kosong) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
