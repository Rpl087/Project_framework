# ============================================================
# Laravel — Generated Files
# ============================================================
/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.phpactor.json
.phpunit.result.cache

# ============================================================
# Environment & Secrets — JANGAN PERNAH di-commit!
# ============================================================
.env
.env.*
!.env.example
/auth.json

# ============================================================
# Database — berisi data real pengguna, SENSITIF!
# ============================================================
/database/*.db
/database/*.sqlite
/database/*.sqlite3
/database/*.sqlite-shm
/database/*.sqlite-wal

# ============================================================
# Storage — file upload & log, bisa besar & sensitif
# ============================================================
/storage/logs/*.log
/storage/app/private/*
!/storage/app/private/.gitignore

# ============================================================
# Script Lokal — spesifik mesin, tidak relevan untuk repo
# ============================================================
start-ngrok.bat
*.bat
!artisan.bat

# ============================================================
# IDE & Editor
# ============================================================
/.fleet
/.idea
/.nova
/.vscode
/.zed
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# Deployment & Infra — konfigurasi server lokal
# ============================================================
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
